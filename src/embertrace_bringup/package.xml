<?xml version="1.0"?>
<package format="3">
  <name>embertrace_bringup</name>
  <version>0.1.0</version>
  <description>Top-level launch and configuration package for EmberTrace.</description>
  <maintainer email="team@example.com">EmberTrace student team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>embertrace_core</exec_depend>
  <exec_depend>embertrace_interfaces</exec_depend>
  <exec_depend>embertrace_sim</exec_depend>
  <exec_depend>embertrace_ui</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>


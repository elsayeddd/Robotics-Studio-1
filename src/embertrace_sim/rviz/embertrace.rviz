Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 34; 40; 34
    Fixed Frame: husky1_odom
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground Grid
      Enabled: true
      Cell Size: 1
      Plane: XY
      Color: 90; 100; 90
    - Class: rviz_default_plugins/RobotModel
      Name: Husky
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /husky1/robot_description
    - Class: rviz_default_plugins/LaserScan
      Name: LiDAR
      Enabled: true
      Topic:
        Value: /husky1/scan
      Size (Pixels): 3
      Style: Points
      Color: 40; 220; 140
    - Class: rviz_default_plugins/Map
      Name: SLAM Map
      Enabled: true
      Topic:
        Value: /husky1/map
      Alpha: 0.55
    - Class: rviz_default_plugins/MarkerArray
      Name: Smoke Samples
      Enabled: true
      Marker Topic:
        Value: /embertrace/sample_markers
    - Class: rviz_default_plugins/Pose
      Name: Investigation Goal
      Enabled: true
      Topic:
        Value: /embertrace/navigation_goal
      Shape: Arrow
      Color: 255; 200; 0
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: Estimated Fire Source
      Enabled: true
      Topic:
        Value: /embertrace/source_estimate
      Shape: Arrow
      Color: 255; 80; 60
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /husky1/initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /husky1/goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 35
      Pitch: 0.8
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
Window Geometry:
  Width: 1200
  Height: 800

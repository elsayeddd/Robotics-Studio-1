<?xml version="1.0"?>
<sdf version="1.8">
  <model name="drone1">
    <!-- Ideal velocity-controlled aerial proxy, deliberately without rotor dynamics. -->
    <link name="drone1_base_link">
      <gravity>false</gravity>
      <inertial><mass>1.5</mass><inertia><ixx>0.03</ixx><iyy>0.03</iyy><izz>0.06</izz></inertia></inertial>
      <collision name="body"><geometry><box><size>0.6 0.6 0.2</size></box></geometry></collision>
      <visual name="body"><geometry><box><size>0.35 0.28 0.15</size></box></geometry><material><ambient>0.1 0.3 0.8 1</ambient><diffuse>0.1 0.3 0.8 1</diffuse></material></visual>
      <visual name="arm_x"><geometry><box><size>0.9 0.05 0.04</size></box></geometry></visual>
      <visual name="arm_y"><geometry><box><size>0.05 0.9 0.04</size></box></geometry></visual>
      <visual name="rotor_1"><pose>0.4 0 0.06 0 0 0</pose><geometry><cylinder><radius>0.17</radius><length>0.01</length></cylinder></geometry></visual>
      <visual name="rotor_2"><pose>-0.4 0 0.06 0 0 0</pose><geometry><cylinder><radius>0.17</radius><length>0.01</length></cylinder></geometry></visual>
      <visual name="rotor_3"><pose>0 0.4 0.06 0 0 0</pose><geometry><cylinder><radius>0.17</radius><length>0.01</length></cylinder></geometry></visual>
      <visual name="rotor_4"><pose>0 -0.4 0.06 0 0 0</pose><geometry><cylinder><radius>0.17</radius><length>0.01</length></cylinder></geometry></visual>
      <sensor name="imu" type="imu"><always_on>true</always_on><update_rate>50</update_rate><topic>/model/drone1/imu</topic><ignition_frame_id>drone1_base_link</ignition_frame_id></sensor>
    </link>
    <link name="drone1_lidar_link">
      <pose relative_to="drone1_base_link">0 0 0.25 0 0 0</pose>
      <gravity>false</gravity>
      <inertial><mass>0.01</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
      <sensor name="lidar" type="gpu_lidar">
        <always_on>true</always_on><update_rate>10</update_rate><topic>/model/drone1/scan</topic><ignition_frame_id>drone1_lidar_link</ignition_frame_id>
        <lidar><scan><horizontal><samples>180</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>0.2</min><max>30</max><resolution>0.02</resolution></range></lidar>
      </sensor>
    </link>
    <link name="drone1_camera_link">
      <pose relative_to="drone1_base_link">0 0 -0.12 0 1.5707963 0</pose>
      <gravity>false</gravity>
      <inertial><mass>0.01</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
      <sensor name="rgbd_camera" type="rgbd_camera">
        
        <always_on>true</always_on><update_rate>10</update_rate><topic>/model/drone1/camera</topic><ignition_frame_id>drone1_camera_link</ignition_frame_id>
        <camera><horizontal_fov>1.57</horizontal_fov><image><width>320</width><height>240</height></image><clip><near>0.1</near><far>30</far></clip><depth_camera><clip><near>0.2</near><far>30</far></clip></depth_camera></camera>
      </sensor>
    </link>
    <joint name="camera_joint" type="fixed"><parent>drone1_base_link</parent><child>drone1_camera_link</child></joint>
    <joint name="lidar_joint" type="fixed"><parent>drone1_base_link</parent><child>drone1_lidar_link</child></joint>
    <plugin filename="ignition-gazebo-velocity-control-system" name="ignition::gazebo::systems::VelocityControl"><topic>/model/drone1/cmd_vel</topic></plugin>
    <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
      <odom_topic>/model/drone1/odometry</odom_topic><odom_frame>husky1_odom</odom_frame><robot_base_frame>drone1_base_link</robot_base_frame><odom_publish_frequency>20</odom_publish_frequency><dimensions>3</dimensions>
    </plugin>
  </model>
</sdf>
